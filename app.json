
{
  "expo": {
    "name": "Calculadora React Native",
    "slug": "calculadora-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "android": {
      "package": "com.proyecto.calculadorarn",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Calculadora React Native"
    },
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
